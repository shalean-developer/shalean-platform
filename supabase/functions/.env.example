# Supabase Edge Function secrets (set in Dashboard → Edge Functions → Secrets)
# For local: supabase functions serve whatsapp-worker --env-file supabase/.env.local

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# WhatsApp Cloud API (required for whatsapp-worker)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v19.0

# Optional tuning (defaults match apps/web)
WHATSAPP_QUEUE_RETRY_BASE_SEC=60
WHATSAPP_QUEUE_BACKPRESSURE_THRESHOLD=1000
WHATSAPP_QUEUE_CIRCUIT_RETRY_MAX_MS=25000
WHATSAPP_MAX_SEND_RATE=20
