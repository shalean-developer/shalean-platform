# Local / EAS public env for the Customer app.
# Copy to .env and fill values. Never commit .env.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=https://shalean.co.za
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Paystack public key only (pk_…) — never put the secret key in the app
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Optional until `eas init` for this app
# EXPO_PUBLIC_EAS_PROJECT_ID=
# EXPO_PUBLIC_BUILD_NUMBER=0

# Crash reporting (Sentry) — leave empty until project DSN exists
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_DEV=0

# Web bundler output: omit for auto (single in expo start, static in production export)
# EXPO_PUBLIC_WEB_OUTPUT=single
# EXPO_PUBLIC_WEB_OUTPUT=static
