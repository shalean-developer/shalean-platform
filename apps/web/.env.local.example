# Shalean local development only.
# Copy this file to apps/web/.env.local after starting the local Supabase stack.
# Never place production or hosted Supabase credentials in this file.

SHALEAN_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Supabase CLI defaults. Confirm with: npm run dev:local:status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Fill these with the LOCAL keys printed by: npm run dev:local:env
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

# Keep external delivery/payment integrations disabled or sandboxed locally.
OUTBOUND_MESSAGING_DISABLED=true
SHALEAN_ENFORCE_ENV_SAFETY=true

# Add other non-production secrets only when a feature specifically needs them.
# Never copy live Paystack, production service-role, customer, banking, or messaging credentials here.
