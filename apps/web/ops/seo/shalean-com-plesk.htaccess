# =============================================================================
# shalean.com → https://shalean.co.za migration (Plesk / Apache / LiteSpeed)
# STATUS: LIVE_HTTP_VERIFIED — applied on Plesk and HTTP-verified 2026-07-22
# Source of truth: apps/web/lib/seo/shaleanComMigrationMap.ts
# Evidence: docs/audits/seo/SHALEAN-COM-PLESK-HTTP-VERIFICATION-2026-07-22.md
# Regenerate: npx tsx -e "import { buildShaleanComHtaccessRules } from './lib/seo/shaleanComMigrationMap.ts'; console.log(buildShaleanComHtaccessRules())"
# =============================================================================
#
# Verified (2026-07-22, curl -sI --max-redirs 0):
# - https://shalean.com/ and www → 301 https://shalean.co.za/
# - https://shalean.com/blog and www/blog → 301 https://shalean.co.za/blog (WordPress 200 closed)
# - article, services, contact, quote, location hub → matching .co.za one-hop 301
#
# Keep the path-preserve fallback last. Do not commit recoverable .htaccess backups
# or hosting credentials into git.
# =============================================================================

RewriteEngine On

# Kill www.shalean.com WordPress stay — always leave .com for .co.za
RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^/?$ https://shalean.co.za/ [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^blog/?$ https://shalean.co.za/blog [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^blog/(.*)$ https://shalean.co.za/blog/$1 [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^contact/?$ https://shalean.co.za/contact [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^quote/?$ https://shalean.co.za/quote [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^services/?$ https://shalean.co.za/services [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^about-us-shalean-cleaning-services/?$ https://shalean.co.za/about [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^about/?$ https://shalean.co.za/about [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^testimonials/?$ https://shalean.co.za/reviews [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^team/?$ https://shalean.co.za/about [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^how-it-works/?$ https://shalean.co.za/#how-it-works [R=301,L,QSA,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^cleaning-prices-cape-town/?$ https://shalean.co.za/blog/how-much-does-cleaning-cost-cape-town-2026 [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^cleaning-services-cape-town/?$ https://shalean.co.za/services [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^maid-services-cape-town/?$ https://shalean.co.za/services [R=301,L,QSA]

# Path-preserving fallback (must remain last)
RewriteCond %{HTTP_HOST} ^(www\.)?shalean\.com$ [NC]
RewriteRule ^(.*)$ https://shalean.co.za/$1 [R=301,L,QSA]
