{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "github": {
    "autoAlias": false
  },
  "crons": [
    {
      "path": "/api/cron/referral-credit-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/referral-credit-expiry",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/referral-campaigns",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/cron/promotions",
      "schedule": "0 5 * * *"
    }
  ]
}
