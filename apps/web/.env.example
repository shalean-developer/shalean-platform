# E2E_CLEANER_SUPABASE_JWT=eyJ...
# E2E_WIDGET_DRAFT=1
# Paystack sandbox E2E (see e2e/paystack/README.md)
# E2E_PAYSTACK=1
# E2E_PAYSTACK_VERIFY_REFERENCE=Tnx_xxx_or_pay_xxx
# E2E_PAYSTACK_FULL=1
# E2E_PAYSTACK_WEBHOOK_REPLAY=1
# Dispatch + dashboard lifecycle E2E (see e2e/dispatch/README.md)
# E2E_DISPATCH=1
# E2E_DISPATCH_LOAD_TEST_SECRET=
# E2E_CUSTOMER_SUPABASE_JWT=
# E2E_CLEANER_SUPABASE_JWT=
# E2E_ADMIN_SUPABASE_JWT=
# E2E_DISPATCH_SELECTED_CLEANER_ID=
# Revenue path smoke (see e2e/smoke/README.md)
# E2E_REVENUE_PATH=1

# Launch readiness E2E + admin checklist (see e2e/launch/README.md)
# E2E_LAUNCH=1
# LAUNCH_CHECK_CUSTOMER_USER_ID=
# LAUNCH_CHECK_CLEANER_ID=
# LAUNCH_CHECK_CLEANER_USER_ID=
# LAUNCH_CHECK_ADMIN_USER_ID=
# LAUNCH_CHECK_ADMIN_EMAIL=
# ENABLE_LAUNCH_CHECK=true

# =============================================================================
# SEO — programmatic location hubs (optional overrides from Search Console tuning)
# =============================================================================
# **Recommended for local dev:** keep readable JSON in a file (see config/location-seo-feedback.example.json).
#   1. Copy:  cp config/location-seo-feedback.example.json config/location-seo-feedback.json
#   2. Paste your GSC export rows into that file (or use the script below).
#   3. In `.env.local` add ONE line:
#      LOCATION_SEO_FEEDBACK_JSON_FILE=./config/location-seo-feedback.json
#   4. Restart `npm run dev`.
#
# **Production / Vercel:** use a single-line env var (no file on server):
#   LOCATION_SEO_FEEDBACK_JSON={"gscMetrics":{"sea-point-cleaning-services":{"impressions":1240,"clicks":52,"ctr":0.042,"avg_position":6.8}}}
#
# Slugs must match hub slugs exactly (e.g. `sea-point-cleaning-services`, not `/locations/...`).
# GSC fields: impressions, clicks, ctr (decimal 0–1, e.g. 0.042 = 4.2%), avg_position (number).
#
# Build from a rows file (recommended — avoids PowerShell encoding issues):
#   npx tsx scripts/gsc-rows-to-location-feedback-json.ts ./tmp/gsc-rows.json -o config/location-seo-feedback.json --catalog --merge
#
# Fill all catalog hubs + optional GSC CSV export:
#   npx tsx scripts/sync-gsc-location-feedback.ts --catalog --merge
#   npx tsx scripts/sync-gsc-location-feedback.ts --csv ./tmp/gsc-pages.csv --catalog --merge
#
# Rows JSON example:
#   [{"slug":"sea-point-cleaning-services","impressions":1240,"clicks":52,"ctr":0.042,"avg_position":6.8}]
#
# LOCATION_SEO_FEEDBACK_JSON_FILE=./config/location-seo-feedback.json
# LOCATION_SEO_FEEDBACK_JSON=
#
# **Automatic GSC sync (recommended for SEO Insights dashboard):**
# Add the service account to Search Console (Full access), then set:
# GSC_CLIENT_EMAIL=shalean-seo@shalean-seo.iam.gserviceaccount.com
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GSC_SITE_URL=sc-domain:shalean.co.za
# GSC_SYNC_DAYS=90
# Manual sync: POST /api/admin/seo/gsc-sync (admin session) or office SEO Insights → Sync GSC.
# Daily cron: GET /api/cron/gsc-sync with Authorization: Bearer CRON_SECRET (Supabase pg_cron — see docs/runbook-cron-secret-rotation.md).
# Metrics persist in Supabase `location_gsc_metrics` + `location_gsc_queries` + `location_gsc_sync_meta`
# (migrations 20260960, 20261052, 20261053). Re-sync after deploy to populate prior-period trends.
# Per slug: DB sync overlays env/file (DB wins); env/file fills slugs missing from DB.
#
# SEO optimizer cron (POST /api/cron/seo-optimization with Bearer CRON_SECRET):
# SEO_OPTIMIZATION_AUTO_APPLY_TITLE=false   — upsert winning template into seo_auto_title_variant (never overrides manual titles or env titleVariant).
# SEO_OPTIMIZATION_AUTO_APPLY_HUB_UI=false  — upsert seo_auto_hub_ui_patch (hero CTA order / emphasis only).
# SEO_OPTIMIZATION_HUB_UI_MANUAL_SLUGS=sea-point-cleaning-services,camps-bay-cleaning-services
#   Comma-separated location slugs protected from optimizer hub UI changes. Use this for any manually tuned hub UI.
# Auto-apply is capped at 10 title variants and 10 hub UI patches per optimizer run; minimum confidence is 0.35.
# Every applied title/UI change is transactionally recorded in `seo_auto_apply_audit`.

#
# Optional stamp for hub “editorial review” line (ISO date):
# LOCATION_HUB_LAST_CONTENT_REFRESH=2026-05-04
#
# Optional: sitemap `lastModified` for marketing/service/legal hubs (ISO date). Falls back to LOCATION_HUB_LAST_CONTENT_REFRESH, then a static baseline.
# MARKETING_SITEMAP_LAST_MODIFIED=2026-06-22

# =============================================================================
# App URLs (client + server)
# =============================================================================
# Canonical public origin for metadata, JSON-LD, sitemap, and OG (no trailing slash). Production: https://shalean.co.za
# Public site origin (used in layout metadataBase, canonicals, JSON-LD). Use apex https://shalean.co.za — not www (www still redirects, but this keeps metadata/sitemap consistent).
# Include https://, or use a bare hostname — invalid values fall back to production apex.
NEXT_PUBLIC_SITE_URL=https://shalean.co.za
# Fallback for canonical origin if NEXT_PUBLIC_SITE_URL is unset (same rules: bare hostname OK; invalid URL falls back to apex in lib/site/canonical.ts).
NEXT_PUBLIC_APP_URL=
# SMS / offer links; defaults in dev
OFFER_SMS_BASE_URL=
NEXT_PUBLIC_SOCKET_IO_URL=
NEXT_PUBLIC_REVIEW_URL=
# Secret for viewing draft/scheduled `blog_posts` in production: `/blog/[slug]?preview=<token>` (dev may use `?preview=true`).
# BLOG_DRAFT_PREVIEW_TOKEN=
# Verbose `getPostBySlug` logs in production when debugging (🚀 FETCHING SLUG …).
# BLOG_DEBUG_FETCH=1
# =============================================================================
# SEO — Google Business (public)
# =============================================================================
# Optional: direct link to leave a Google review (e.g. search.google.com/local/writereview?placeid=…).
# Enables homepage/footer CTAs, job-complete email, and SMS prompts.
NEXT_PUBLIC_GOOGLE_REVIEW_WRITE_URL=
# Optional: public profile URLs for JSON-LD LocalBusiness sameAs (verified links only; omit if unknown).
# NEXT_PUBLIC_BRAND_FACEBOOK_URL=https://www.facebook.com/shaleancleaning/
# NEXT_PUBLIC_BRAND_INSTAGRAM_URL=https://www.instagram.com/shalean_cleaning_services
# NEXT_PUBLIC_BRAND_LINKEDIN_URL=https://www.linkedin.com/company/your-company
# NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=https://g.page/your-profile or Maps listing URL
#
# Optional: homepage JSON-LD WebSite SearchAction only — URL template must include literal `{search_term_string}`.
# Enable only after you ship a real on-site search endpoint (there is no `/search` route by default).
# NEXT_PUBLIC_SITE_SEARCH_ACTION_TARGET=https://shalean.co.za/search?q={search_term_string}
#
# Optional: Search Console HTML tag verification (meta tag in root layout via NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION).
# Prefer DNS verification in production; keep tokens out of git.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token


# =============================================================================
# Support & booking display (public)
# =============================================================================
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=
# Set to false to stop appending ?promo= on marketing CTAs (SAVE10 / WELCOME50). Inbound ?promo= links still work.
# NEXT_PUBLIC_BOOKING_MARKETING_PROMO_IN_URLS=false
NEXT_PUBLIC_BOOKING_SERVICE_FEE_RULE=
NEXT_PUBLIC_BOOKING_SERVICE_FEE_CENTS=
# Optional booking schedule A/B (client-only): default pick strategy — score | cheapest | fastest_confirm
# NEXT_PUBLIC_SCHEDULE_AB_DEFAULT=
# Optional: initial slot row count before “See more” (4–12, default 7)
# NEXT_PUBLIC_SCHEDULE_VISIBLE_SLOTS=
# Optional: Microsoft Clarity session replay/heatmaps project id. Leave empty to disable.
NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID=
# Optional: Google Tag Manager container id (production). Renders `gtm.js` from `app/layout.tsx`. Example: GTM-5XRFHPL8
# GTM GA4 Configuration tag must use ONLY the apex stream G-GEVTBDWTQW (https://shalean.co.za).
# Do not add G-6JR2GPGPN3 (legacy/www-linked). Leave the old stream in GA Admin; stop sending to it.
NEXT_PUBLIC_GTM_ID=
# Canonical GA4 Measurement ID for https://shalean.co.za (default G-GEVTBDWTQW). Legacy G-6JR2GPGPN3 is ignored if set.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-GEVTBDWTQW
# GA4_MEASUREMENT_ID=G-GEVTBDWTQW
# If both GTM and direct GA4 are enabled for the same property, disable duplicate page_view in one path.
# SEO growth events use `dataLayer` from `lib/growth/trackEvent.ts` — map those in GTM when using GTM-only GA4.
# Optional: Google Ads account id (AW-…). Default AW-11050850519 (Shalean Cleaning Services).
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label from Google Ads → Goals → Purchase (send_to = AW-ID/LABEL). Required for purchase conversion events.
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# Optional: GA4 Measurement Protocol API secret (existing server path). Durable purchase redesign is a follow-up PR.
# Create secrets on the G-GEVTBDWTQW (apex) stream only — never on G-6JR2GPGPN3.
# GA4_MEASUREMENT_PROTOCOL_SECRET=
# Optional: Meta (Facebook) Pixel id — client PageView + Purchase on /account/success
# NEXT_PUBLIC_META_PIXEL_ID=
# Server Conversions API (same pixel). Create a system user token with ads_management in Events Manager.
# META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager test code while validating CAPI
# META_CAPI_TEST_EVENT_CODE=
BOOKING_SERVICE_FEE_RULE=
BOOKING_SERVICE_FEE_CENTS=

# =============================================================================
# Admin & dashboard auth
# =============================================================================
# Optional bootstrap allowlist (comma-separated). Prefer user_profiles.role=admin for new Office admins.
# Admin APIs also accept profile role=admin without listing the email here.
ADMIN_EMAILS=
# Single admin email fallback (see lib/auth/admin.ts)
ADMIN_EMAIL=
# Optional bearer for ops smoke script / tooling
ADMIN_SECRET=

# =============================================================================
# Secrets: cron, HMAC, test routes
# =============================================================================
CRON_SECRET=
# Analytics warehouse (SQL `run_analytics_warehouse_nightly` via pg_cron, or POST /api/cron/analytics-warehouse): refreshes MVs + daily rollups; optional Slack alert on UTC booking_completed drops.
#ANALYTICS_SLACK_WEBHOOK_URL=
# Set to 1 to skip Slack drop detection (still runs warehouse RPC).
#ANALYTICS_BOOKING_DROP_ALERTS_DISABLED=
# Optional: only one scheduler should finalize monthly invoices. Set e.g. MONTHLY_INVOICE_FINALIZE_REQUIRE_RUNNER=vercel
# and CRON_SOURCE=vercel on Vercel. Supabase pg_net: send header x-monthly-finalize-runner: supabase and set REQUIRE_RUNNER=supabase there.
#MONTHLY_INVOICE_FINALIZE_REQUIRE_RUNNER=vercel
#CRON_SOURCE=vercel
BOOKING_LOCK_HMAC_SECRET=
EMAIL_TEST_SECRET=
WHATSAPP_TEST_SEND_SECRET=
# Local/staging only: secret for POST /api/test/create-booking (header x-dispatch-load-test-secret).
DISPATCH_LOAD_TEST_SECRET=
# Optional cap for soft-dispatch wait per request (ms). Default 12000 in code if unset.
DISPATCH_LOAD_TEST_OFFER_TIMEOUT_MS=
# Must be "true" on production to expose the load-test route (still requires DISPATCH_LOAD_TEST_SECRET).
ENABLE_DISPATCH_LOAD_TEST=
# Non-production only: POST /api/test/create-booking patches the first `locations` row if lat/lng are null (defaults: Cape Town centroid).
DISPATCH_LOAD_TEST_SEED_LAT=
DISPATCH_LOAD_TEST_SEED_LNG=

# =============================================================================
# Email (Resend)
# =============================================================================
RESEND_API_KEY=
# Preferred: full from header with a monitored inbox (avoid noreply — Resend flags it).
# e.g. Shalean Cleaning Services <hello@shalean.co.za>
RESEND_FROM=
# Legacy (still supported): split name + email used on older Vercel projects
# RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=
# When `1` / `true`, logs payment → notification tracing (grep `notify-booking-debug`). Do not leave on in prod unless diagnosing.
SHALEAN_NOTIFY_BOOKING_DEBUG=

# =============================================================================
# Bookings financial snapshot (server)
# =============================================================================
# `SHALEAN_BOOKINGS_FINANCIAL_SNAPSHOT_COLS` was removed in H-11.
# `paid_at`, `refunded_at`, `refund_status` are now always selected (the
# columns have been mandatory in every environment since migrations