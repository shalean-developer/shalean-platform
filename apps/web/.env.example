# Cron / background job tuning
# =============================================================================
FAILED_JOBS_ALERT_THRESHOLD=
FAILED_JOBS_CLEANUP_ENABLED=
UNASSIGNABLE_BOOKINGS_ALERT_THRESHOLD=
# Retention window for diagnostic `system_logs` rows. Used by the
# `/api/cron/prune-system-logs` cron (RPC `prune_system_logs`).
# Default 30 days. Clamped to [1, 365]. Non-numeric / <=0 falls back to 30.
# Only deletes from `public.system_logs` — never financial audit tables
# (`admin_earnings_actions`, `payment_events`, `cleaner_payouts`,
# `cleaner_earnings`, `bookings`).
SYSTEM_LOG_RETENTION_DAYS=

# =============================================================================
# Blog — legacy in-repo routes (disable after hub posts live in blog_posts)
# =============================================================================
# When false, programmaticPosts.ts and highConversionPosts.ts contribute no /blog URLs.
NEXT_PUBLIC_LEGACY_PROGRAMMATIC_ROUTES=
NEXT_PUBLIC_LEGACY_HIGH_CONVERSION_ROUTES=

# =============================================================================
# Ops smoke checklist (scripts/ops-smoke-checklist.mjs)
# =============================================================================
OPS_APP_BASE_URL=
OPS_DISPATCH_TEST_BOOKING_ID=
