# Copy to `.env.local` for local development. Never commit real secrets.
# `NODE_ENV` is set by Next.js — do not set it here unless you know you need to.

# =============================================================================
# Environment identity (ENV-01)
# =============================================================================
# Explicit deployment identity. On Vercel set per target:
#   Production → production
#   Preview + git branch staging → staging
#   Preview + git branch development → development
# SHALEAN_APP_ENV=development
#
# Canonical Supabase refs (never put service-role keys in git):
#   production  → tchayecuvzssixyxlvfu
#   staging     → gbgnemlpyykyhpqqbgru  (persistent project shalean-platform-staging)
#   development → mbvixuzfvzbooiurvxwz  (persistent project shalean-platform-development)
# Legacy ephemeral branches (do not target for shared UAT): gfvdiczqyrvlmynvgegd / hborcpvarvgynjsjnfei
#
# Non-production outbound messaging (fail closed without allowlist):
# OUTBOUND_MESSAGING_DISABLED=true
# OUTBOUND_EMAIL_ALLOWLIST=qa@shalean.co.za,you@example.com
# OUTBOUND_PHONE_ALLOWLIST=+27820000000
# OUTBOUND_MESSAGING_ALLOW_ALL=true   # lab override only — never on shared staging
# SHALEAN_ENFORCE_ENV_SAFETY=true     # local fail-closed (always on when VERCEL=1)

# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: non-public URL alias (admin client falls back to NEXT_PUBLIC_*)
SUPABASE_URL=
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Legacy alias read by lib/supabase/admin.ts
SUPABASE_SERVICE_KEY=

# =============================================================================
# Playwright E2E (optional — see e2e/README.md)
