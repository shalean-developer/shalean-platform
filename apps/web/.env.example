# Legacy env service-fee overrides (BOOKING_SERVICE_FEE_*) require:
# LEGACY_ENV_SERVICE_FEE_ENABLED=true

# =============================================================================
# Zoho Books (invoice sync)
# Invoices are synced to Zoho Books on finalization (monthly) and payment (per-booking).
# Leave blank to disable Zoho sync — billing flows continue without it.
#
# Setup:
#   1. Create a "Server-based Application" OAuth app at https://api-console.zoho.com/
#   2. Grant scopes: ZohoBooks.invoices.ALL ZohoBooks.contacts.ALL ZohoBooks.settings.READ
#   3. Generate initial refresh token via the Zoho OAuth playground / curl and store below.
#   4. Find your Organization ID in Zoho Books → Settings → Organization Profile.
#   Optional: set ZOHO_ACCOUNTS_DOMAIN / ZOHO_API_DOMAIN for non-.com Zoho regions
#             (e.g. .eu, .in, .com.au, .jp).
# =============================================================================
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
# ZOHO_API_DOMAIN=www.zohoapis.com

# =============================================================================
# OpenAI (admin AI insights, etc.)
# =============================================================================
OPENAI_API_KEY=

# =============================================================================
# Google Maps (travel / routing)
# =============================================================================
GOOGLE_MAPS_API_KEY=

# =============================================================================
# Google Business Profile (Marketing Hub OAuth + local posts)
# =============================================================================
# Create a Web OAuth client in Google Cloud. Enable:
#   - My Business Account Management API
#   - My Business Business Information API
#   - Google My Business API (Local Posts)
# Consent scope: https://www.googleapis.com/auth/business.manage
# Redirect URI must match exactly (prod example below; local: http://localhost:3000/api/oauth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://shalean.co.za/api/oauth/google/callback
# Optional AES key for encrypting refresh/access tokens (64-char hex preferred).
# If omitted, a key is derived from GOOGLE_CLIENT_SECRET.
# SOCIAL_TOKEN_ENCRYPTION_KEY=

# Optional Facebook Page one-click publish (env Page token — not OAuth):
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_GRAPH_API_VERSION=v22.0

